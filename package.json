{
  "name": "roel-decort-portfolio",
  "description": "Personal technical portfolio and field-notes site for Roel de Cort.",
  "type": "module",
  "version": "0.0.1",
  "packageManager": "pnpm@10.11.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "node scripts/local-server.mjs start",
    "stop": "node scripts/local-server.mjs stop",
    "restart": "node scripts/local-server.mjs restart",
    "dev": "astro dev",
    "build": "astro check && astro build && pagefind --site dist && cp -r dist/pagefind public/",
    "check": "pnpm run lint && pnpm run format:check && pnpm run build && pnpm run check:links",
    "check:links": "node scripts/check-internal-links.mjs dist https://decort.tech",
    "preview": "astro preview",
    "local:start": "node scripts/local-server.mjs start",
    "local:start:preview": "node scripts/local-server.mjs start --preview",
    "local:stop": "node scripts/local-server.mjs stop",
    "local:restart": "node scripts/local-server.mjs restart",
    "local:status": "node scripts/local-server.mjs status",
    "local:logs": "tail -f .astro/local-server.log",
    "sync": "astro sync",
    "astro": "astro",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "lint": "eslint ."
  },
  "dependencies": {
    "@astrojs/mdx": "^6.0.1",
    "@astrojs/rss": "^4.0.18",
    "@astrojs/sitemap": "^3.7.3",
    "@tailwindcss/vite": "^4.3.0",
    "astro": "^6.4.2",
    "dayjs": "^1.11.21",
    "lodash.kebabcase": "^4.1.1",
    "remark-collapse": "^0.1.2",
    "remark-toc": "^9.0.0",
    "slugify": "^1.6.9",
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@pagefind/default-ui": "^1.5.2",
    "@shikijs/transformers": "^4.1.0",
    "@tailwindcss/typography": "^0.5.19",
    "@types/lodash.kebabcase": "^4.1.9",
    "@typescript-eslint/parser": "^8.59.4",
    "eslint": "^10.4.0",
    "eslint-plugin-astro": "^1.7.0",
    "pagefind": "^1.5.2",
    "prettier": "3.8.3",
    "prettier-plugin-astro": "0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "typescript": "^6.0.3"
  }
}
